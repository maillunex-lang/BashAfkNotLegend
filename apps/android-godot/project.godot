; Engine configuration file.
config_version=5

[application]

config/name="Bashkiria Heroes Prototype"
config/description="Android-first visual battle prototype — Bashkir Anime Sarcastic Fantasy 2D"
run/main_scene="res://scenes/battle/BattlePrototype.tscn"
